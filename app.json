{
  "expo": {
    "name": "FastRest",
    "slug": "fastrest",
    "version": "1.0.0",
    "scheme": "fastrest",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-secure-store",
      "expo-notifications",
      "expo-font"
    ],
    "android": {
      "package": "uz.fastrest.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88f2719c-ca65-460e-8240-088e99f3b72b"
      }
    }
  }
}
